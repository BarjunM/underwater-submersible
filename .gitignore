# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment — never commit secrets. Commit .env.example instead if one is
# ever needed; everything else here stays local.
.env
.env.*
!.env.example

# Hosting
.vercel

# Logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local agent/editor tooling — useful on this machine, no part of the site
.claude/
.superpowers/

# Raw CAD exports: ~51 MB of intermediate OBJ, regenerated by the STEP
# conversion. Only the converted GLB and the baked edges are committed.
site/public/models/raw/

# Byproducts of the FreeCAD conversion script
site/scripts/__pycache__/
site/scripts/_convert-report.txt

# A local one-off screenshot utility: hardcoded machine paths and an
# undeclared puppeteer-core dependency. No part of the build.
_capture.mjs
